# ─────────────────────────────────────────────────────────────────────────────
# Yanzx AI — server-side only configuration.
# Copy this file to .env.local and fill in real values.
# These variables are read ONLY inside app/api/**/route.ts (server runtime).
# Anything prefixed with NEXT_PUBLIC_ ships to the browser — never put a key
# in a NEXT_PUBLIC_ variable, and never commit a real key to this file.
# ─────────────────────────────────────────────────────────────────────────────

# Any OpenAI-compatible chat-completions endpoint (the code appends
# /chat/completions to this base URL).
# Examples: https://api.openai.com/v1 · https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1

# Must be one of the ids in lib/models.ts, otherwise the catalog default is
# used. Run `curl /api/models` on a deployment to list them.
AI_MODEL=free/Claude-Opus-5.5

# The provider secret. Paste the value here locally, and set it in the hosting
# dashboard for deployments — never in a committed file.
AI_API_KEY=

# Optional: legacy alias, read only when AI_API_KEY is empty.
# YANZX_API_KEY=

# Optional: set to "demo" to force the built-in offline generator (no API calls).
# AI_DEMO_MODE=

# Optional: Supabase persistence for /api/projects.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
