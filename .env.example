# ─────────────────────────────────────────────────────────────────────────────
# Yanzx AI — server-side only configuration.
# Copy this file to .env.local and fill in real values.
# These variables are read ONLY inside app/api/**/route.ts (server runtime).
# Anything prefixed with NEXT_PUBLIC_ ships to the browser — never put a key
# in a NEXT_PUBLIC_ variable.
# ─────────────────────────────────────────────────────────────────────────────

# Any OpenAI-compatible chat-completions endpoint.
# Examples: https://api.openai.com/v1 · https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Optional: override the key variable the route reads (defaults to AI_API_KEY,
# then falls back to YANZX_API_KEY for backwards compatibility).
# YANZX_API_KEY=

# Optional: set to "demo" to force the built-in offline generator (no API calls).
# AI_DEMO_MODE=
